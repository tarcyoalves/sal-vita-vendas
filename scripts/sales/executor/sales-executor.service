# Unit systemd do executor de vendas (Sal Vita Sales AI).
#
# Instalação (como root, na VPS) — o passo a passo completo está em ../README.md:
#   1. Ajuste User, WorkingDirectory e ExecStart para o seu ambiente.
#   2. Crie /etc/sales-executor.env (permissão 600, dono root) com as variáveis do README.
#      NUNCA dentro do repositório — ele é público. Comece com SALES_DRY_RUN=1.
#   3. sudo cp sales-executor.service /etc/systemd/system/sales-executor.service
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now sales-executor
#   6. journalctl -u sales-executor -f        # acompanhar os logs
#
# O diário local (SQLite) fica em /var/lib/sales-executor (criado pelo systemd).
# Ele é a memória que evita e-mail duplicado: não apague, não restaure de backup antigo.

[Unit]
Description=Executor de vendas da Sal Vita (despacho de e-mail e leitura da caixa)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=salesexec
Group=salesexec
WorkingDirectory=/opt/sal-vita-vendas/scripts/sales/executor
EnvironmentFile=/etc/sales-executor.env
Environment=SALES_JOURNAL_PATH=/var/lib/sales-executor/journal.sqlite3
Environment=PYTHONUNBUFFERED=1
StateDirectory=sales-executor
ExecStart=/usr/bin/python3 worker.py
# Parou por segurança (401, falha de login, 3 falhas permanentes, rajada de devoluções)?
# O processo continua vivo só enviando heartbeat com parado=1. Reiniciar NÃO libera a parada.
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=5
# Dá tempo de terminar o envio em curso antes de matar.
TimeoutStopSec=90

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sales-executor

[Install]
WantedBy=multi-user.target
