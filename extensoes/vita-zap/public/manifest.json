{
  "manifest_version": 3,
  "name": "Vita Zap",
  "version": "0.4.0",
  "description": "CRM dentro do WhatsApp Web: abas de triagem, lembretes de follow-up, notas, etiquetas e respostas rápidas. Você sempre aperta o Enter: a extensão nunca envia sozinha.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir o Vita Zap",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  }
}
