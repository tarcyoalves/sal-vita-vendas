{
  "manifest_version": 3,
  "name": "Vita Zap",
  "version": "0.3.1",
  "description": "Copiloto comercial no WhatsApp Web. Padrão: você aperta o Enter. Modo automático opcional (viola os Termos do WhatsApp; risco de bloqueio do número).",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir o Vita Zap"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
