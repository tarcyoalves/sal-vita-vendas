{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/email-daily", "schedule": "0 11 * * *" },
    { "path": "/api/cron/abandoned-cart", "schedule": "0 15 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy",   "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://salvitarn.com.br https://*.salvitarn.com.br https://www.facebook.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.facebook.com https://*.facebook.net; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
      },
      "continue": true
    },
    {
      "src": "/robots\\.txt",
      "has": [{ "type": "host", "value": "lembretes\\.salvitarn\\.com\\.br" }],
      "dest": "/robots-crm.txt"
    },
    {
      "src": "/sal-vita-admin",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/sal-vita-admin",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/sal-vita-b2b",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/sal-vita-b2b",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/sal-vita-recovery",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/sal-vita-recovery",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/meu-pedido",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/meu-pedido",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/atacado",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/atacado",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/api/bundle.js"
    },
    {
      "src": "/api/(.*)",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/api/bundle.js"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml|assets/.*|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|map|webmanifest|json|txt|xml))",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/$1"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml|assets/.*|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|map|webmanifest|json|txt|xml))",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www\\.premium\\.salvitarn\\.com\\.br" }],
      "dest": "/sal-vita"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "premium\\.salvitarn\\.com\\.br" }],
      "dest": "/sal-vita"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/bundle.js"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|map|webmanifest|json|txt|xml))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
